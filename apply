#!/usr/bin/env zsh
set -euo pipefail

cd "$HOME/dotfiles"
STOW_LOG_FILE="stow.log"
CURRENT_HOST="$(hostname -s)"
FAST_MODE=false
BOOTSTRAP_MODE=false
UPDATE_SOPS=false

for argument in "$@"; do
    case "$argument" in
        --fast)
            FAST_MODE=true
            ;;
        --bootstrap)
            BOOTSTRAP_MODE=true
            ;;
        --update-sops)
            UPDATE_SOPS=true
            ;;
        *)
          echo "Unknown argument: $1"
          exit 2
          ;;
    esac
done

if [ "$BOOTSTRAP_MODE" = true ]; then
    source "./config/common/.config/zsh/.zshenv"
fi

if [ "$BOOTSTRAP_MODE" = false ] && [ "$CURRENT_HOST" = "samakro" ]; then
    if [ ! -f "$HOME/Library/Application Support/sops/age/keys.txt" ]; then
        echo "Error: Missing master decryption key at ~/Library/Application Support/sops/age/keys.txt"
        echo "Try running: nix shell nixpkgs#age -c age-keygen -o ~/Library/Application\ Support/sops/age/keys.txt"
        exit 1
    fi

    decrypt_sops_file() {
        local filename="$1"
        local output="$HOME/$filename"

        echo "Decrypting $filename"
        mkdir -p "$(dirname "$output")"
        run_cmd sops --decrypt "config/secret/$filename" >"$output"
    }

    echo "Decrypting sops files"
    # sops encrypt ~/.config/qBittorrent/qBittorrent.ini > .config/qBittorrent/qBittorrent.ini
    decrypt_sops_file ".config/nix/nix.conf"
    decrypt_sops_file ".config/qBittorrent/qBittorrent.ini"
    # decrypt_sops_file "Media/Downloads/Anna.yaml"
    # decrypt_sops_file ".config/kindle-manager/config.toml"
    # decrypt_sops_file ".config/anvil.json"
fi

if [ "$BOOTSTRAP_MODE" = false ] && [ "$UPDATE_SOPS" = true ]; then
    # nix shell nixpkgs#ssh-to-age -c ssh-to-age -i /etc/ssh/ssh_host_ed25519_key.pub
    update_sops_file() {
        local filename="$1"
        echo "Updating $filename"
        yes | run_cmd sops updatekeys "config/secret/$filename"
    }

    echo "Updating sops keys"
    update_sops_file ".config/nix/nix.conf"
    update_sops_file ".config/qBittorrent/qBittorrent.ini"
    update_sops_file "Media/Downloads/Anna.yaml"
    update_sops_file ".config/kindle-manager/config.toml"
    update_sops_file ".config/anvil.json"
    yes | run_cmd sops updatekeys "hosts/roscu/secrets.yaml"
fi

echo "Running gnu stow"
run_cmd stow --ignore=.DS_Store --verbose=1 -d "config" -t "$HOME" common "$CURRENT_HOST" 2>&1 | tee -a "$STOW_LOG_FILE"

echo "Formatting nix files"
run_cmd alejandra --quiet **/*.nix

if [ "$FAST_MODE" = true ]; then
    echo "Skipping flake updates and system derivation switch"
    return
fi

if [ "$CURRENT_HOST" = "samakro" ]; then
    echo "Rebuilding nix darwin"
    sudo darwin-rebuild switch --flake .#"${CURRENT_HOST}"
fi

if [ "$CURRENT_HOST" = "roscu" ]; then
    echo "Rebuilding nixos"
    sudo nixos-rebuild switch --flake ".#${CURRENT_HOST}"
fi
